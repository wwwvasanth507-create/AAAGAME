{
  "bindings": [
    { "action": "move_forward",      "key": "W",      "gamepad": "Left Stick Up" },
    { "action": "move_back",         "key": "S",      "gamepad": "Left Stick Down" },
    { "action": "move_left",         "key": "A",      "gamepad": "Left Stick Left" },
    { "action": "move_right",        "key": "D",      "gamepad": "Left Stick Right" },
    { "action": "sprint",            "key": "Shift",  "gamepad": "Left Stick Press" },
    { "action": "walk",              "key": "Ctrl",   "gamepad": "" },
    { "action": "jump",              "key": "Space",  "gamepad": "South (A/Cross)" },
    { "action": "roll",              "key": "Q",      "gamepad": "East (B/Circle)" },
    { "action": "crouch",            "key": "C",      "gamepad": "Right Stick Press" },
    { "action": "attack",            "mouse": "Left", "gamepad": "Right Trigger" },
    { "action": "heavy_attack",      "mouse": "Right","gamepad": "Left Trigger" },
    { "action": "block",             "key": "F",      "gamepad": "Left Bumper" },
    { "action": "skill_1",           "key": "1",      "gamepad": "North (Y/Triangle)" },
    { "action": "skill_2",           "key": "2",      "gamepad": "West (X/Square)" },
    { "action": "skill_3",           "key": "3",      "gamepad": "Right Bumper" },
    { "action": "skill_4",           "key": "4",      "gamepad": "" },
    { "action": "interact",          "key": "E",      "gamepad": "DPad Down" },
    { "action": "lock_target",       "key": "R",      "gamepad": "Right Stick Press" },
    { "action": "open_inventory",    "key": "I",      "gamepad": "DPad Right" },
    { "action": "open_map",          "key": "M",      "gamepad": "DPad Left" },
    { "action": "open_quests",       "key": "J",      "gamepad": "DPad Up" },
    { "action": "open_settings",     "key": "Escape", "gamepad": "Start" },
    { "action": "pause",             "key": "P",      "gamepad": "Select" },
    { "action": "camera_rotate_left","key": "Left",   "gamepad": "Right Stick Left" },
    { "action": "camera_rotate_right","key": "Right", "gamepad": "Right Stick Right" },
    { "action": "camera_zoom_in",    "key": "=",      "gamepad": "" },
    { "action": "camera_zoom_out",   "key": "-",      "gamepad": "" },
    { "action": "camera_reset",      "key": "V",      "gamepad": "Right Stick Press" }
  ],
  "touch_layout": "default",
  "left_handed_mode": false,
  "joystick_type": "dynamic",
  "joystick_radius": 80,
  "button_size": 90,
  "joystick_opacity": 0.55,
  "double_tap_action": "roll",
  "swipe_up_action": "jump",
  "long_press_action": "interact"
}
