[gd_scene load_steps=2 format=3 uid="uid://mainmenu000"]

[ext_resource type="Script" path="res://Scripts/UI/MainMenuController.cs" id="1_menuctrl"]

; -----------------------------------------------------------------------
; ROOT CONTROL — full-screen canvas
; -----------------------------------------------------------------------
[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menuctrl")

; -----------------------------------------------------------------------
; BACKGROUND
; -----------------------------------------------------------------------
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.04, 0.08, 1.0)

; -----------------------------------------------------------------------
; CENTRE PANEL — contains all buttons
; -----------------------------------------------------------------------
[node name="CentrePanel" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.3
anchor_top = 0.25
anchor_right = 0.7
anchor_bottom = 0.85
grow_horizontal = 2
grow_vertical = 2

; -----------------------------------------------------------------------
; TITLE LABEL
; -----------------------------------------------------------------------
[node name="TitleLabel" type="Label" parent="CentrePanel"]
layout_mode = 2
text = "HERO OF ETERNIA"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 48

; -----------------------------------------------------------------------
; SUBTITLE
; -----------------------------------------------------------------------
[node name="SubtitleLabel" type="Label" parent="CentrePanel"]
layout_mode = 2
text = "v0.11.0 — Prototype"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
modulate = Color(0.6, 0.6, 0.6, 1.0)

; SPACER
[node name="Spacer" type="Control" parent="CentrePanel"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)

; -----------------------------------------------------------------------
; PLAY BUTTON
; -----------------------------------------------------------------------
[node name="PlayButton" type="Button" parent="CentrePanel"]
layout_mode = 2
text = "PLAY"
custom_minimum_size = Vector2(0, 60)
theme_override_font_sizes/font_size = 22

; -----------------------------------------------------------------------
; SETTINGS BUTTON
; -----------------------------------------------------------------------
[node name="SettingsButton" type="Button" parent="CentrePanel"]
layout_mode = 2
text = "SETTINGS"
custom_minimum_size = Vector2(0, 52)
theme_override_font_sizes/font_size = 18

; -----------------------------------------------------------------------
; QUIT BUTTON
; -----------------------------------------------------------------------
[node name="QuitButton" type="Button" parent="CentrePanel"]
layout_mode = 2
text = "QUIT"
custom_minimum_size = Vector2(0, 52)
theme_override_font_sizes/font_size = 18

; -----------------------------------------------------------------------
; VERSION LABEL — bottom right corner
; -----------------------------------------------------------------------
[node name="VersionLabel" type="Label" parent="."]
layout_mode = 1
anchor_left = 0.0
anchor_top = 0.95
anchor_right = 1.0
anchor_bottom = 1.0
text = "Hero of Eternia — Prototype Build 0.11.0"
horizontal_alignment = 2
theme_override_font_sizes/font_size = 12
modulate = Color(0.5, 0.5, 0.5, 1.0)
