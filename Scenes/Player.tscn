[gd_scene load_steps=6 format=3 uid="uid://player_root"]

[ext_resource type="Script" path="res://Scripts/Player/PlayerRoot.cs" id="1_playerroot"]
[ext_resource type="Script" path="res://Scripts/Player/PlayerAnimationController.cs" id="2_anim"]
[ext_resource type="Script" path="res://Scripts/Player/PlayerAudioController.cs" id="3_audio"]
[ext_resource type="Script" path="res://Scripts/Input/InputHandler.cs" id="4_input"]
[ext_resource type="Script" path="res://Scripts/Camera/CameraController.cs" id="5_camera"]

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1_playerroot")

; -----------------------------------------------------------------------
; COLLISION SHAPE — capsule fitting a humanoid character
; -----------------------------------------------------------------------
[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = CapsuleShape3D.new()
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.95, 0)

; -----------------------------------------------------------------------
; MODEL ROOT — swap this child for any 3D character model
; -----------------------------------------------------------------------
[node name="Model" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

; Placeholder mesh (MeshInstance3D with a CapsuleMesh until art is imported)
[node name="MeshInstance3D" type="MeshInstance3D" parent="Model"]
mesh = CapsuleMesh.new()
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.95, 0)

; AnimationPlayer — states drive this via PlayerAnimationController
[node name="AnimationPlayer" type="AnimationPlayer" parent="Model"]

; -----------------------------------------------------------------------
; MODULES (scripts that don't need a separate visual node)
; -----------------------------------------------------------------------
[node name="PlayerAnimationController" type="Node" parent="."]
script = ExtResource("2_anim")

[node name="PlayerAudioController" type="Node" parent="."]
script = ExtResource("3_audio")

[node name="InputHandler" type="Node" parent="."]
script = ExtResource("4_input")

; -----------------------------------------------------------------------
; GROUND / WALL / CEILING DETECTION HELPERS
; -----------------------------------------------------------------------
[node name="GroundCheck" type="RayCast3D" parent="."]
enabled = true
target_position = Vector3(0, -1.1, 0)
collision_mask = 1

[node name="WallCheckFront" type="RayCast3D" parent="."]
enabled = true
target_position = Vector3(0, 0, -0.6)
collision_mask = 1

[node name="CeilingCheck" type="RayCast3D" parent="."]
enabled = true
target_position = Vector3(0, 1.2, 0)
collision_mask = 1

; -----------------------------------------------------------------------
; INTERACTION POINT — used by interact system to find interactable objects
; -----------------------------------------------------------------------
[node name="InteractionPoint" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, -0.8)

; -----------------------------------------------------------------------
; WEAPON HOLDER — future weapon system attach point
; -----------------------------------------------------------------------
[node name="WeaponHolder" type="Node3D" parent="Model"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.35, 1.2, 0.1)

; -----------------------------------------------------------------------
; EFFECTS ROOT — particle emitters attach here
; -----------------------------------------------------------------------
[node name="Effects" type="Node3D" parent="."]

[node name="FootDust" type="GPUParticles3D" parent="Effects"]
emitting = false
amount = 12
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)

; -----------------------------------------------------------------------
; CAMERA PIVOT — parent of the CameraController
; -----------------------------------------------------------------------
[node name="CameraPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="CameraController" type="Node3D" parent="CameraPivot"]
script = ExtResource("5_camera")

; -----------------------------------------------------------------------
; FUTURE MOUNT & PET POINTS
; -----------------------------------------------------------------------
[node name="MountPoint" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.1, 0)

[node name="PetPoint" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.8, 0.1, -0.5)
